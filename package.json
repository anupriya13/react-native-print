{
  "name": "react-native-print",
  "version": "0.11.0",
  "description": "Print documents with React Native",
  "main": "index.js",
  "types": "types/index.d.ts",
  "keywords": [
    "react-native",
    "print",
    "ndef",
    "react",
    "native"
  ],
  "repository": {
    "type": "git",
    "url": "github:christopherdro/react-native-print"
  },
  "peerDependencies": {
    "react-native": ">=0.8.0 || 0.8.0-rc || 0.8.0-rc.2 || 0.9.0-rc || 0.10.1",
    "react-native-windows": ">=0.62"
  },
  "author": "Christopher Dro <casheghian@gmail.com> (http://chris.si)",
  "license": "MIT",
  "dependencies": {
    "react-native": "0.77.2",
    "react-native-windows": "0.77.7"
  },
  "codegenConfig": {
    "name": "RNPrint",
    "type": "modules",
    "jsSrcsDir": "codegenSpecs",
    "windows": {
      "namespace": "RNPrintCodegen",
      "outputDirectory": "windows/RNPrint/codegen",
      "separateDataTypes": true
    }
  },
  "react-native-windows": {
    "init-windows": {
      "name": "RNPrint",
      "namespace": "RNPrint",
      "template": "cpp-lib"
    }
  }
}
